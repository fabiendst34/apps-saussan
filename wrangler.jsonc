{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apps-saussan",
  "main": "src/index.js",

  // Compte Cloudflare personnel de Fabien (et non celui de Kevin) :
  // fixe ici pour lever l'ambiguite entre les deux comptes accessibles.
  "account_id": "73c47f960a8baffb72252952ab8f16f5",

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Le sous-domaine workers.dev reste ouvert le temps de la bascule : declarer
  // des routes le desactive sinon d'office, ce qui coupe le site tant que le
  // nouveau domaine n'est pas propage. A repasser a false une fois la
  // transition terminee, pour n'exposer qu'une seule adresse.
  "workers_dev": true,

  // Domaine de l'association. Cloudflare cree l'enregistrement DNS et le
  // certificat automatiquement ; le Worker redirige www vers le domaine nu.
  "routes": [
    { "pattern": "apps-saussan.fr", "custom_domain": true },
    { "pattern": "www.apps-saussan.fr", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apps-saussan",
      "database_id": "6e054e9b-f7cf-4367-8e08-24668b4aae71"
    }
  ],

  "vars": {
    "SITE_URL": "https://apps-saussan.fr",
    "SITE_NAME": "APPS — Association des Parents des Pitchouns Saussannais",
    "CONTACT_EMAIL": "apps.saussan@gmail.com",
    "MAIL_FROM": "apps.saussan@gmail.com",
    "MAIL_FROM_NAME": "APPS Saussan",
    "ALLOW_INDEXING": "false",

    // Iterations PBKDF2 pour le hachage des mots de passe.
    // 50000 ~ 6 ms de CPU : tient dans la limite de 10 ms du plan Workers gratuit.
    // Sur le plan payant (5 $/mois, limite portee a 30 s), passer a "210000".
    "PBKDF2_ITERATIONS": "50000"
  }

  // Secrets a poser avec `wrangler secret put` :
  //   MAILJET_API_KEY     -> cle publique Mailjet
  //   MAILJET_API_SECRET  -> cle privee Mailjet
}
